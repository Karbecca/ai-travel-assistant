APP_NAME=AI Travel Assistant
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Local development (SQLite file next to the working directory)
DATABASE_URL=sqlite:///./ai_travel_assistant.db

# Example PostgreSQL URL (install driver; see requirements.txt)
# DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/ai_travel_assistant

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_TEMPERATURE=0.7
ANTHROPIC_MAX_TOKENS=2000

WEATHER_API_KEY=your-openweathermap-key
OPENTRIPMAP_API_KEY=your-opentripmap-key

# Datadog observability (optional — app runs without these)
DD_AGENT_HOST=localhost
DD_STATSD_PORT=8125
DD_SERVICE=ai-travel-assistant
DD_ENV=development

# Guardrails
GUARDRAIL_MAX_INPUT_LENGTH=2000
GUARDRAIL_MIN_DAYS=1
GUARDRAIL_MAX_DAYS=30
